    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').item.json;\nconst fields = $json.extracted_fields || {};\n\n// --- Check 1: required-field completeness (full_name is the one universal field\n// every identity/income document should carry) ---\nlet completeness_status, completeness_message;\nif (fields.full_name && String(fields.full_name).trim().length > 0) {\n  completeness_status = 'PASSED';\n  completeness_message = 'full_name present.';\n} else {\n  completeness_status = 'FAILED';\n  completeness_message = 'full_name missing from extracted fields.';\n}\n\n// --- Check 2: expiry date, only applicable if the field was populated ---\nlet expiry_status, expiry_message;\nif (!fields.expiry_date) {\n  expiry_status = 'PASSED';\n  expiry_message = 'No expiry_date field present for this document type.';\n} else {\n  const expiry = new Date(fields.expiry_date);\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  if (isNaN(expiry.getTime())) {\n    expiry_status = 'WARNING';\n    expiry_message = `Could not parse expiry_date value: \"${fields.expiry_date}\".`;\n  } else if (expiry < today) {\n    expiry_status = 'FAILED';\n    expiry_message = `Document expired on ${fields.expiry_date}.`;\n  } else {\n    expiry_status = 'PASSED';\n    expiry_message = `Valid until ${fields.expiry_date}.`;\n  }\n}\n\n// --- Aggregate ---\nlet overall_status;\nif (completeness_status === 'FAILED' || expiry_status === 'FAILED') {\n  overall_status = 'FAILED';\n} else if (completeness_status === 'WARNING' || expiry_status === 'WARNING') {\n  overall_status = 'WARNING';\n} else {\n  overall_status = 'PASSED';\n}\n\nreturn [{ json: {\n  document_id: input.document_id,\n  application_id: input.application_id,\n  intelligence_result_id: input.document_intelligence_result_id,\n  completeness_status,\n  completeness_message,\n  expiry_status,\n  expiry_message,\n  overall_status\n} }];"
      },
