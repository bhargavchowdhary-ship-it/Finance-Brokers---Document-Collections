    {
      "parameters": {
        "jsCode": "const body = $json.payload || $json;\nconst document_id = body.document_id;\nconst document_intelligence_result_id = body.document_intelligence_result_id;\nconst application_id = body.application_id;\n\nif (!document_id) throw new Error('document_id missing from input payload');\nif (!document_intelligence_result_id) throw new Error('document_intelligence_result_id missing from input payload');\nif (!application_id) throw new Error('application_id missing from input payload');\n\nreturn [{ json: { document_id, document_intelligence_result_id, application_id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1904,
