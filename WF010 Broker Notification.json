    {
      "parameters": {
        "jsCode": "const body = $json.payload || $json;\nconst application_id = body.application_id;\nif (!application_id) throw new Error('application_id missing from input payload');\nreturn [{ json: { application_id } }];"
      },
      "id": "3cecc984-e255-4b9c-8941-c0e8ffe69e04",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2176,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT br.name AS broker_name, br.email AS broker_email,\n  la.application_number, la.loan_type, la.requested_amount,\n  b.first_name AS borrower_first_name, b.last_name AS borrower_last_name,\n  dr.final_decision, dr.decision_reason, dr.confidence_score\nFROM loan_applications la\nJOIN brokers br ON br.id = la.broker_id\nJOIN application_borrowers ab ON ab.application_id = la.id AND ab.is_primary = true\nJOIN borrowers b ON b.id = ab.borrower_id\nLEFT JOIN decision_results dr ON dr.application_id = la.id\nWHERE la.id = $1\nORDER BY dr.created_at DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.application_id] }}"
        }
      },
      "id": "db57d0a7-cc56-41c9-a928-1bb195166544",
      "name": "Get Application Decision Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1952,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "SyBhUj6REgmcuPkX",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').first().json;\nconst ctx = $('Get Application Decision Context').first().json;\nconst borrowerName = `${ctx.borrower_first_name || ''} ${ctx.borrower_last_name || ''}`.trim() || 'the borrower';\nconst amount = ctx.requested_amount ? Number(ctx.requested_amount).toLocaleString('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }) : 'N/A';\n\nlet subject, headline;\nif (ctx.final_decision === 'MANUAL_REVIEW') {\n  subject = `Action needed: Application ${ctx.application_number} — ${borrowerName}`;\n  headline = `Application ${ctx.application_number} for ${borrowerName} needs your review. Cross-validation found a discrepancy across the borrower's documents that our automated checks can't resolve on their own.`;\n} else {\n  subject = `Application ${ctx.application_number} ready for review — ${borrowerName}`;\n  headline = `Application ${ctx.application_number} for ${borrowerName} has completed document collection, verification, and cross-validation.`;\n}\n\nconst message = `Hi ${ctx.broker_name || 'there'},\\n\\n`\n  + `${headline}\\n\\n`\n  + `Loan type: ${ctx.loan_type || 'N/A'}\\n`\n  + `Requested amount: ${amount}\\n`\n  + `Decision: ${ctx.final_decision || 'N/A'}\\n`\n  + `Details: ${ctx.decision_reason || 'N/A'}\\n\\n`\n  + (ctx.final_decision === 'MANUAL_REVIEW'\n    ? `Please review the flagged documents and decide how to proceed.\\n\\n`\n    : `This application is ready for your review and submission.\\n\\n`)\n  + `— Mortgage Broker AI Platform`;\n\nreturn [{ json: { ...input, ...ctx, subject, message } }];"
      },
      "id": "a203ce0b-59b4-43bb-81d4-f0ecffc59919",
