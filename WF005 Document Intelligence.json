    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4.1\",\n  response_format: { type: \"json_object\" },\n  temperature: 0,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a mortgage document data extraction engine for an Australian broker platform. Extract ONLY the following universal fields from the supplied OCR text. Return strict JSON, no commentary. Fields: full_name (string or null), date_of_birth (YYYY-MM-DD or null), address (string or null), document_number (string or null), expiry_date (YYYY-MM-DD or null), issuer (string or null). If a field is not present in this document type, return null for it — do not guess or fabricate.\"\n    },\n    {\n      role: \"user\",\n      content: `Document type: ${$('Get Document Type').item.json.code} (${$('Get Document Type').item.json.category})\\n\\nOCR TEXT:\\n${$('Get OCR Result').item.json.raw_text}`\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -448,
        96
      ],
      "id": "be520f94-c980-4bbe-b975-7fc8a470a3a3",
      "name": "Call GPT-4.1 Extraction",
      "credentials": {
        "openAiApi": {
          "id": "lpIEEhIqDSzxZl1P",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst input = $('Prepare Version Payload').item.json;\nconst reasons = [];\nlet fields = {};\n\ntry {\n  fields = JSON.parse(resp.choices[0].message.content);\n} catch (e) {\n  reasons.push('invalid_json_from_model');\n}\n\nif (resp.error) reasons.push(resp.error.message || 'openai_error');\n\nconst REQUIRED_KEYS = ['full_name','date_of_birth','address','document_number','expiry_date','issuer'];\nconst present = REQUIRED_KEYS.filter(k => fields[k] !== null && fields[k] !== undefined && fields[k] !== '');\nconst confidence_score = Math.round((present.length / REQUIRED_KEYS.length) * 100 * 100) / 100;\n\nif (present.length === 0) reasons.push('no_fields_extracted');\n\nconst usage = resp.usage || {};\nconst processing_time_ms = Date.now() - input.started_at;\n\nreturn [{ json: {\n  document_id: input.document_id,\n  ocr_result_id: input.ocr_result_id,\n  application_id: input.application_id,\n  document_version_id: $('Create Document Version').item.json.id,\n  is_success: reasons.length === 0,\n  reasons,\n  extracted_fields: fields,\n  confidence_score,\n  processing_time_ms,\n  prompt_tokens: usage.prompt_tokens || null,\n  completion_tokens: usage.completion_tokens || null,\n  total_tokens: usage.total_tokens || null\n} }];"
      },
