    {
      "parameters": {
        "jsCode": "function simpleHash(str) {\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    hash = (hash << 5) - hash + str.charCodeAt(i);\n    hash |= 0;\n  }\n  return Math.abs(hash).toString(16);\n}\n\nconst storagePath = $('Get Document').item.json.storage_path;\nif (!storagePath) {\n  throw new Error('storage_path missing from Get Document output');\n}\n\nconst priorVersions = $('Get many rows').all();\nconst nextVersion = (priorVersions.length > 0 && priorVersions[0].json.version_number != null)\n  ? priorVersions[0].json.version_number + 1\n  : 1;\n\nreturn {\n  ...$json,\n  file_hash: simpleHash(storagePath),\n  version_number: nextVersion\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
