    {
      "parameters": {
        "jsCode": "const application_id = $('Normalize Input').first().json.application_id;\nconst outcome = $('Get Cross Validation Outcome').first().json;\nconst mismatches = $input.all().map(i => i.json).filter(m => m.field_name);\n\nlet final_decision, decision_reason;\n\nif (outcome.overall_status === 'FAILED') {\n  final_decision = 'MANUAL_REVIEW';\n  if (mismatches.length > 0) {\n    const details = mismatches.map(m => `${m.field_name}: \"${m.value_1}\" vs \"${m.value_2}\" (${m.validation_notes})`).join('; ');\n    decision_reason = `Cross-validation found ${mismatches.length} field mismatch(es) across documents: ${details}. Manual broker review required before proceeding.`;\n  } else {\n    decision_reason = 'Cross-validation reported FAILED status but no MISMATCH rows were found. Manual review required to investigate.';\n  }\n} else {\n  final_decision = 'MORE_DOCUMENTS_REQUIRED';\n  decision_reason = 'No completed cross-validation record found for this application yet. Required documents may still be outstanding.';\n}\n\nreturn [{ json: { application_id, final_decision, decision_reason, mismatch_count: mismatches.length } }];"
      },
