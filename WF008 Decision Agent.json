    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT field_name, value_1, value_2, validation_notes\nFROM cross_validation_results\nWHERE loan_application_id = $1\n  AND validation_status = 'MISMATCH'\nORDER BY field_name;",
        "options": {
          "queryReplacement": "={{ [$('Normalize Input').item.json.application_id] }}"
        }
      },
      "id": "d3b0d5a8-bcd5-4008-ac95-a58659fa7c1d",
      "name": "Get Mismatch Details",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1504,
        560
      ],
      "credentials": {
        "postgres": {
          "id": "SyBhUj6REgmcuPkX",
          "name": "Postgres account"
        }
      }
