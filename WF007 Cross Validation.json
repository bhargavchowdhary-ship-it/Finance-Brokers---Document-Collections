    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (dir.document_id)\n  dir.id AS intelligence_result_id,\n  dir.document_id,\n  dir.extracted_fields\nFROM document_intelligence_results dir\nJOIN documents d ON d.id = dir.document_id\nJOIN document_checklists dc ON dc.id = d.checklist_id\nWHERE dc.application_id = $1\n  AND d.processing_status = 'VERIFIED'\n  AND dir.intelligence_status = 'COMPLETED'\nORDER BY dir.document_id, dir.created_at DESC;",
        "options": {
          "queryReplacement": "={{ [$('Normalize Input').item.json.application_id] }}"
        }
      },
      "id": "aa446846-dd94-40b3-8faf-bd93ea2abc31",
      "name": "Get Verified Intelligence Results",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1504,
        272
      ],
      "credentials": {
        "postgres": {
          "id": "SyBhUj6REgmcuPkX",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function normalize(s) {\n  if (!s) return '';\n  return String(s).toLowerCase().trim()\n    .replace(/[.,#]/g, '')\n    .replace(/\\bst\\b/g, 'street')\n    .replace(/\\brd\\b/g, 'road')\n    .replace(/\\bave\\b/g, 'avenue')\n    .replace(/\\bapt\\b/g, 'apartment')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction levenshtein(a, b) {\n  const m = a.length, n = b.length;\n  if (m === 0) return n;\n  if (n === 0) return m;\n  const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));\n  for (let i = 0; i <= m; i++) dp[i][0] = i;\n  for (let j = 0; j <= n; j++) dp[0][j] = j;\n  for (let i = 1; i <= m; i++) {\n    for (let j = 1; j <= n; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost);\n    }\n  }\n  return dp[m][n];\n}\n\nfunction similarity(a, b) {\n  const na = normalize(a), nb = normalize(b);\n  const maxLen = Math.max(na.length, nb.length, 1);\n  return 1 - (levenshtein(na, nb) / maxLen);\n}\n\nfunction compareFuzzy(v1, v2, matchAt, partialAt) {\n  if (!v1 || !v2) {\n    return { status: 'MISSING', score: null, notes: 'One or both documents do not carry this field.' };\n  }\n  const score = Math.round(similarity(v1, v2) * 100 * 100) / 100;\n  if (score >= matchAt) return { status: 'MATCH', score, notes: `Similarity ${score}%.` };\n  if (score >= partialAt) return { status: 'PARTIAL_MATCH', score, notes: `Fuzzy match, similarity ${score}%.` };\n  return { status: 'MISMATCH', score, notes: `Similarity only ${score}% - below acceptable threshold.` };\n}\n\nfunction compareDate(v1, v2) {\n  if (!v1 || !v2) {\n    return { status: 'MISSING', score: null, notes: 'One or both documents do not carry this field.' };\n  }\n  const d1 = new Date(v1), d2 = new Date(v2);\n  if (isNaN(d1.getTime()) || isNaN(d2.getTime())) {\n    return { status: 'PARTIAL_MATCH', score: null, notes: 'Could not parse one or both dates for exact comparison.' };\n  }\n  const iso1 = d1.toISOString().slice(0, 10);\n  const iso2 = d2.toISOString().slice(0, 10);\n  if (iso1 === iso2) return { status: 'MATCH', score: 100, notes: `Both documents show ${iso1}.` };\n  return { status: 'MISMATCH', score: 0, notes: `Dates differ: ${iso1} vs ${iso2}.` };\n}\n\nconst docs = $input.all().map(i => i.json);\nconst application_id = $('Normalize Input').first().json.application_id;\n\nconst comparisons = [];\nlet overall_status = 'PASSED';\n\nfor (let i = 0; i < docs.length; i++) {\n  for (let j = i + 1; j < docs.length; j++) {\n    const a = docs[i], b = docs[j];\n    const fa = a.extracted_fields || {};\n    const fb = b.extracted_fields || {};\n\n    const checks = [\n      { field_name: 'full_name', result: compareFuzzy(fa.full_name, fb.full_name, 90, 75) },\n      { field_name: 'address', result: compareFuzzy(fa.address, fb.address, 80, 60) },\n      { field_name: 'date_of_birth', result: compareDate(fa.date_of_birth, fb.date_of_birth) }\n    ];\n\n    for (const c of checks) {\n      comparisons.push({\n        loan_application_id: application_id,\n        document_intelligence_result_1_id: a.intelligence_result_id,\n        document_intelligence_result_2_id: b.intelligence_result_id,\n        field_name: c.field_name,\n        value_1: (fa[c.field_name] !== undefined && fa[c.field_name] !== null) ? String(fa[c.field_name]) : null,\n        value_2: (fb[c.field_name] !== undefined && fb[c.field_name] !== null) ? String(fb[c.field_name]) : null,\n        validation_status: c.result.status,\n        confidence_score: c.result.score,\n        validation_notes: c.result.notes,\n        ai_provider: null,\n        ai_model: null\n      });\n      if (c.result.status === 'MISMATCH') overall_status = 'FAILED';\n    }\n  }\n}\n\nif (docs.length < 2) {\n  overall_status = 'FAILED';\n  comparisons.push({\n    loan_application_id: application_id,\n    document_intelligence_result_1_id: docs[0] ? docs[0].intelligence_result_id : null,\n    document_intelligence_result_2_id: docs[0] ? docs[0].intelligence_result_id : null,\n    field_name: 'document_count',\n    value_1: String(docs.length),\n    value_2: null,\n    validation_status: 'MISSING',\n    confidence_score: null,\n    validation_notes: 'Fewer than 2 verified documents - nothing to cross-validate against.',\n    ai_provider: null,\n    ai_model: null\n  });\n}\n\nreturn [{ json: { application_id, overall_status, document_count: docs.length, comparisons } }];"
      },
