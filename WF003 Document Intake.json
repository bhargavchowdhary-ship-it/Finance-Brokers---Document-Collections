    {
      "parameters": {
        "jsCode": "const doc = $('Get Document').item.json;\nconst ALLOWED_MIME = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];\nconst MAX_BYTES = 15 * 1024 * 1024; // 15MB\n\nconst reasons = [];\nif (!ALLOWED_MIME.includes(doc.mime_type)) reasons.push('unsupported_file_type');\nif (!doc.file_size_bytes || doc.file_size_bytes === 0) reasons.push('empty_file');\nif (doc.file_size_bytes > MAX_BYTES) reasons.push('file_too_large');\nif (doc.is_password_protected) reasons.push('password_protected');\n\nreturn [{ json: {\n  document_id: doc.id,\n  checklist_id: doc.checklist_id,\n  application_id: $('Get Loan Application').item.json.id,\n  storage_path: doc.storage_path,\n  mime_type: doc.mime_type,\n  is_valid: reasons.length === 0,\n  reasons\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
