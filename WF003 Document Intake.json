    {
      "parameters": {
        "jsCode": "const body = $json.payload || $json;\nconst document_id = body.document_id;\nconst checklist_id = body.checklist_id;\nconst workflow_instance_id = body.workflow_instance_id || null;\nconst loan_application_id = body.loan_application_id || null;\n\nif (!document_id) {\n  throw new Error('document_id missing from input payload');\n}\nif (!checklist_id) {\n  throw new Error('checklist_id missing from input payload');\n}\n\nreturn [{ json: {\n  document_id,\n  checklist_id,\n  workflow_instance_id,\n  loan_application_id\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
