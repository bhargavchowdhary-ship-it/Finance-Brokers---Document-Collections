          "id": "lpIEEhIqDSzxZl1P",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst input = $('Encode Base64').item.json;\nconst reasons = [];\n\nlet raw_text = '';\ntry {\n  raw_text = resp.choices[0].message.content || '';\n} catch (e) {\n  reasons.push('no_content_in_response');\n}\n\nif (resp.error) reasons.push(resp.error.message || 'openai_error');\nif (!raw_text || raw_text.trim().length === 0) reasons.push('empty_transcription');\n\nconst usage = resp.usage || {};\nconst processing_time_ms = Date.now() - input.started_at;\n\nreturn [{ json: {\n  document_id: input.document_id,\n  ocr_result_id: input.ocr_result_id,\n  is_success: reasons.length === 0,\n  reasons,\n  raw_text,\n  prompt_tokens: usage.prompt_tokens || null,\n  completion_tokens: usage.completion_tokens || null,\n  total_tokens: usage.total_tokens || null,\n  processing_time_ms,\n  page_count: 1\n} }];"
      },
