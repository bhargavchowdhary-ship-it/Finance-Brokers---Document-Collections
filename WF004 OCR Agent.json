      "parameters": {
        "jsCode": "const body = $json.payload || $json;\nconst document_id = body.document_id;\nconst storage_path = body.storage_path;\nconst mime_type = body.mime_type;\nconst application_id = body.application_id;\nconst pdf_password = body.pdf_password || '';\nconst started_at = new Date().toISOString();\n\nif (!document_id) throw new Error('document_id missing from input payload');\nif (!storage_path) throw new Error('storage_path missing from input payload');\nif (!mime_type) throw new Error('mime_type missing from input payload');\nif (!application_id) throw new Error('application_id missing from input payload');\n\nreturn [{ json: { document_id, storage_path, mime_type, application_id, pdf_password, started_at } }];"
