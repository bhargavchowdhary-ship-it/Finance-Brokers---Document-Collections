        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4.1\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are an OCR transcription engine. Transcribe ALL visible text from the supplied document image exactly as written, preserving line order. Do not summarize, translate, or omit any characters, numbers, or dates. Return plain text only, no commentary.\"\n    },\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", text: \"Transcribe this document.\" },\n        { type: \"image_url\", image_url: { url: $json.data_uri } }\n      ]\n    }\n  ],\n  temperature: 0\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
