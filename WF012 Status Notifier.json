    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst document_id = body.document_id || null;\nconst event = String(body.event || body.event_type || '').toUpperCase();\nif (!document_id) throw new Error('document_id missing from webhook payload');\nreturn [{ json: { document_id, event } }];"
      },
      "id": "69a29df4-9644-4ac9-a8a7-f08db778a35d",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
