    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id AS document_id, d.processing_status, dc.application_id, dt.name AS doc_name, dt.code AS doc_code, b.id AS borrower_id, b.first_name, b.telegram_chat_id, la.application_number, cs.id AS conversation_session_id FROM documents d JOIN document_checklists dc ON dc.id = d.checklist_id JOIN document_types dt ON dt.id = dc.document_type_id JOIN loan_applications la ON la.id = dc.application_id JOIN application_borrowers ab ON ab.application_id = dc.application_id AND ab.is_primary = true JOIN borrowers b ON b.id = ab.borrower_id LEFT JOIN conversation_sessions cs ON cs.application_id = dc.application_id AND cs.channel = 'TELEGRAM' WHERE d.id = $1 ORDER BY cs.last_message_at DESC NULLS LAST LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.document_id] }}"
        }
      },
      "id": "3718142a-9971-4bc8-897f-5e5ac6aa3fad",
