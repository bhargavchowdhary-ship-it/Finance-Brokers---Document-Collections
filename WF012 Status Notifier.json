        -1536,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Get Notify Context').first().json;\nconst event = $('Normalize Input').first().json.event;\nconst firstName = ctx.first_name || 'there';\nconst docName = ctx.doc_name || 'your document';\nlet message_text;\nif (event === 'VERIFIED') {\n  message_text = '\\u2705 Good news ' + firstName + '! Your ' + docName + ' has been verified successfully.';\n} else if (event === 'RECEIVED') {\n  message_text = '\\uD83D\\uDCE5 Thanks ' + firstName + '! We\\u2019ve received your ' + docName + ' and started verifying it. I\\u2019ll update you shortly.';\n} else {\n  message_text = '\\u2139\\uFE0F Update on your ' + docName + ': status is now ' + (ctx.processing_status || event) + '.';\n}\nreturn [{ json: { ...ctx, event, message_text } }];"
      },
