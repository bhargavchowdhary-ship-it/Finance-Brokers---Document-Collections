    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').first().json;\nconst ctx = $('Get Borrower Context').first().json;\nconst firstName = ctx.first_name || 'there';\nconst appNum = ctx.application_number || 'your application';\nconst reasonsText = input.reasons.length > 0\n  ? input.reasons.join(' ')\n  : 'We need an updated document from you to continue processing your application.';\nconst message_text = `Hi ${firstName}, regarding ${appNum}: ${reasonsText} Please reply here with the updated document when you're ready.`;\nreturn [{ json: { ...input, ...ctx, message_text } }];"
      },
      "id": "7e93b208-bdde-488f-b232-67d7989f6ec7",
