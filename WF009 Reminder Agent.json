    {
      "parameters": {
        "jsCode": "const body = $json.payload || $json;\nconst application_id = body.application_id;\nif (!application_id) throw new Error('application_id missing from input payload');\nconst document_id = body.document_id || null;\nconst reasons = Array.isArray(body.reasons) ? body.reasons.filter(Boolean) : [];\nconst source = body.source || 'UNKNOWN';\nreturn [{ json: { application_id, document_id, reasons, source } }];"
      },
      "id": "7f04b078-c123-4374-997f-14bc19e7eda8",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2176,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id AS borrower_id, b.first_name, b.telegram_chat_id, b.preferred_channel,\n  la.application_number,\n  cs.id AS conversation_session_id\nFROM loan_applications la\nJOIN application_borrowers ab ON ab.application_id = la.id AND ab.is_primary = true\nJOIN borrowers b ON b.id = ab.borrower_id\nLEFT JOIN conversation_sessions cs ON cs.application_id = la.id AND cs.channel = 'TELEGRAM'\nWHERE la.id = $1\nORDER BY cs.last_message_at DESC NULLS LAST\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.application_id] }}"
        }
      },
      "id": "3b86c50e-2f57-4c6c-b0d2-7ca5d201be9a",
